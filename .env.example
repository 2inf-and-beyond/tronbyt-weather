# https://app.tomorrow.io/development/keys
TOMORROW_API_KEY=

# Default timezone when the Pixlet app doesn't send one (IANA name)
TZ=America/Chicago

# Docker network the Tronbyt server container is on (`docker network ls`)
TRONBYT_NETWORK=tronbyt_default

# Set to 1 to log cache hits/misses
LOG_CACHE=
